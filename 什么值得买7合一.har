[
    {
        "comment": "获取签到状态",
        "request": {
            "method": "GET",
            "url": "https://zhiyou.smzdm.com/user/checkin/jsonp_checkin",
            "headers": [
                {
                    "name": "Accept",
                    "value": "*/*"
                },
                {
                    "name": "Referer",
                    "value": "https://www.smzdm.com/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookies}}"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                }
            ],
            "failed_asserts": [
                {
                    "re": "请先登录",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "checkin_num",
                    "re": "\"checkin_num\":(\\d+)",
                    "from": "content"
                },
                {
                    "name": "gold",
                    "re": "\"gold\":(\\d+)",
                    "from": "content"
                },
                {
                    "name": "point",
                    "re": "\"point\":(\\d+)",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "执行签到",
        "request": {
            "method": "GET",
            "url": "https://zhiyou.smzdm.com/user/checkin/jsonp_checkin",
            "headers": [
                {
                    "name": "Accept",
                    "value": "*/*"
                },
                {
                    "name": "Referer",
                    "value": "https://www.smzdm.com/"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36"
                },
                {
                    "name": "Cookie",
                    "value": "{{cookies}}"
                }
            ],
            "cookies": []
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"error_code\":0",
                    "from": "content"
                }
            ],
            "failed_asserts": [
                {
                    "re": "请先登录",
                    "from": "content"
                },
                {
                    "re": "今日已签到",
                    "from": "content"
                }
            ],
            "extract_variables": [
                {
                    "name": "msg",
                    "re": "\"error_msg\":\"(.+?)\"",
                    "from": "content"
                }
            ]
        }
    },
    {
        "comment": "结果日志汇总",
        "request": {
            "method": "POST",
            "url": "api://util/unicode",
            "headers": [],
            "cookies": [],
            "data": "content=✅ 什么值得买签到完成\\r\\n连续签到：{{checkin_num}} 天\\r\\n金币：{{gold}}\\r\\n积分：{{point}}\\r\\n签到结果：{{msg|default('签到成功')}}"
        },
        "rule": {
            "success_asserts": [
                {
                    "re": "200",
                    "from": "status"
                },
                {
                    "re": "\"状态\": \"200\"",
                    "from": "content"
                }
            ],
            "failed_asserts": [],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "\"转换后\": \"(.*)\"",
                    "from": "content"
                }
            ]
        }
    }
]
